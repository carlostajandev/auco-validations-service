# --- Aplicación ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/auco

# --- DynamoDB Local ---
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_REGION=us-east-1
DYNAMO_AUDIT_TABLE=validation_audit_events
# DynamoDB Local acepta cualquier credencial, pero el SDK exige que existan
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- API externa de enriquecimiento (Exchange Rate, sin API key) ---
ENRICHMENT_BASE_URL=https://open.er-api.com/v6
ENRICHMENT_BASE_CURRENCY=USD
ENRICHMENT_TARGET_CURRENCIES=COP,EUR,MXN,BRL,CLP
ENRICHMENT_TIMEOUT_MS=3000
ENRICHMENT_MAX_RETRIES=2
# La tasa se publica una vez al día: se cachea 10 min y, si el proveedor cae,
# se sigue usando la última buena hasta 24 h.
ENRICHMENT_CACHE_TTL_MS=600000
ENRICHMENT_CACHE_MAX_STALE_MS=86400000
